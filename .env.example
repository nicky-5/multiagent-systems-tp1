# LiteLLM proxy
LITELLM_BASE_URL=https://<proxy-host>
LITELLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Model for the analyst's code generation (the hardest task); empty uses LLM_MODEL.
LLM_CODE_MODEL=
# Sampling temperature; "none" doesn't send it (some newer models reject it)
# LLM_TEMPERATURE=0
# LLM_CODE_TEMPERATURE=0
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mas-2026s2-tables
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mas-2026s2-<legajo>

# Ingestion agent (optional)
# INGEST_MAX_ATTEMPTS=3
# INGEST_MAX_CONCURRENCY=4
# DATA_DIR=./data

# Analyst agent (optional)
# ANALYST_TOP_K=5
# ANALYST_MAX_CANDIDATES=8
# ANALYST_MAX_CODE_ATTEMPTS=3

# Code execution sandbox (optional)
# SANDBOX_TIMEOUT_S=30
# SANDBOX_MEMORY_MB=1024
